---
import { getCollection } from 'astro:content';
import Tour from '../layouts/Tour.astro';
import { TourGate } from '../components/tour/TourGate';
import type { PostEntry } from '../components/tour/PostModal';

const formatDate = (d: Date) =>
  d
    .toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' })
    .toUpperCase();

const blogEntries = await getCollection('blog', ({ data }) => !data.draft);
const blogPosts: PostEntry[] = blogEntries
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    date: formatDate(post.data.date),
    tags: post.data.tags,
    body: post.body ?? '',
  }));

const researchEntries = await getCollection('research', ({ data }) => !data.draft);
const researchPosts: PostEntry[] = researchEntries
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    date: formatDate(post.data.date),
    tags: post.data.tags,
    body: post.body ?? '',
    type: post.data.type,
    severity: 'severity' in post.data ? post.data.severity : undefined,
    cve: 'cve' in post.data ? post.data.cve : undefined,
    program: 'program' in post.data ? post.data.program : undefined,
    platform: 'platform' in post.data ? post.data.platform : undefined,
  }));
---

<Tour>
  <TourGate client:only="react" blogPosts={blogPosts} researchPosts={researchPosts} />
</Tour>

<style is:global>
  #tour-unsupported {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    text-align: center;
    color: #ece7e8;
    font-family: 'JetBrains Mono', monospace;
  }

  .tu-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: #f2a33c;
    margin-bottom: 1.25rem;
  }

  .tu-body {
    max-width: 26rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #b3a8ab;
    margin-bottom: 1.5rem;
  }

  .tu-link {
    font-size: 0.85rem;
    color: #e63950;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
</style>
